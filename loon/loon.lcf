# 基础配置参考 iKeLee / luestr/ProxyResource（CC BY-NC-SA 4.0）。
[General]
ip-mode = v4-only
ipv6-vif = auto
dns-server = 1.1.1.1,1.0.0.1
doh-server = https://1.1.1.1/dns-query,https://1.0.0.1/dns-query
hijack-dns = *:53
sni-sniffing = true
disable-stun = true
dns-reject-mode = LoopbackIP
domain-reject-mode = DNS
udp-fallback-mode = REJECT
allow-wifi-access = false
interface-mode = auto
test-timeout = 5
disconnect-on-policy-change = false
internet-test-url = http://connectivitycheck.platform.hicloud.com/generate_204
proxy-test-url = http://www.gstatic.com/generate_204
resource-parser = https://raw.githubusercontent.com/sub-store-org/Sub-Store/release/sub-store-parser.loon.min.js
geoip-url = https://fastly.jsdelivr.net/gh/Loyalsoldier/geoip@release/Country.mmdb
ipasn-url = https://geodata.kelee.one/GeoLite2-ASN-P3TERX.mmdb
skip-proxy = localhost,*.local
bypass-tun = 0.0.0.0/8,127.0.0.0/8,169.254.0.0/16,224.0.0.0/4,255.255.255.255/32

[Proxy]
占位节点 = http, 127.0.0.1, 9

[Remote Proxy]
# 机场合集 = https://example.com/subscription, udp=true, enabled=true

[Remote Filter]
香港节点 = NameRegex, FilterKey = "^(?=.*((?i)🇭🇰|香港|(\b(HK|HKG|Hong)(\d+)?\b)))(?!.*((?i)回国|校园|游戏|🎮|(\b(GAME)\b))).*$"
台湾节点 = NameRegex, FilterKey = "^(?=.*((?i)🇹🇼|台湾|(\b(TW|TWN|Tai|Taiwan)(\d+)?\b)))(?!.*((?i)回国|校园|游戏|🎮|(\b(GAME)\b))).*$"
日本节点 = NameRegex, FilterKey = "^(?=.*((?i)🇯🇵|日本|东京|大阪|埼玉|(\b(JP|JPN|Japan)(\d+)?\b)))(?!.*((?i)回国|校园|游戏|🎮|(\b(GAME)\b))).*$"
韩国节点 = NameRegex, FilterKey = "^(?=.*((?i)🇰🇷|韩国|韓|首尔|(\b(KR|KOR|Korea)(\d+)?\b)))(?!.*((?i)回国|校园|游戏|🎮|(\b(GAME)\b))).*$"
新加坡节点 = NameRegex, FilterKey = "^(?=.*((?i)🇸🇬|新加坡|狮|(\b(SG|SGP|Singapore)(\d+)?\b)))(?!.*((?i)回国|校园|游戏|🎮|(\b(GAME)\b))).*$"
美国节点 = NameRegex, FilterKey = "^(?=.*((?i)🇺🇸|美国|波特兰|达拉斯|俄勒冈|凤凰城|费利蒙|硅谷|拉斯维加斯|洛杉矶|圣何塞|圣克拉拉|西雅图|芝加哥|(\b(US|USA|United States)(\d+)?\b)))(?!.*((?i)回国|校园|游戏|🎮|(\b(GAME)\b))).*$"
英国节点 = NameRegex, FilterKey = "^(?=.*((?i)🇬🇧|英国|英國|英格兰|英格蘭|London|United Kingdom|(\b(UK|GB|GBR|Britain|British)(\d+)?\b)))(?!.*((?i)回国|校园|游戏|🎮|(\b(GAME)\b))).*$"
全球节点 = NameRegex, FilterKey = "^(?=.*(.))(?!.*((?i)群|邀请|返利|循环|官网|客服|网站|网址|获取|订阅|流量|到期|机场|下次|版本|官址|备用|过期|已用|联系|邮箱|工单|贩卖|通知|倒卖|国内|地址|频道|无法|说明|使用|提示|访问|教程|关注|更新|作者|加入|超时|收藏|福利|好友|失联|(\b(USE|USED|TOTAL|EXPIRE|EMAIL|Panel|Channel|Author|Traffic)(\d+)?\b|(\d{4}-\d{2}-\d{2}|\dG)))).*$"

[Proxy Group]
代理策略 = select,Auto,香港,台湾,新加坡,日本,美国,韩国,英国,img-url = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Proxy.png
兜底策略 = select,代理策略,img-url = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Final.png
Auto = url-test,占位节点,全球节点,interval = 600,tolerance = 100,img-url = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Auto.png
国际基础服务 = select,新加坡,美国,香港,代理策略,img-url = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Global.png
Apple服务 = select,DIRECT,国际基础服务,代理策略,新加坡,美国,img-url = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Apple_1.png
AI = select,美国,新加坡,台湾,日本,代理策略,img-url = https://raw.githubusercontent.com/Orz-3/mini/master/Color/OpenAI.png
国际社媒 = select,香港,新加坡,台湾,日本,美国,英国,代理策略,img-url = https://raw.githubusercontent.com/Orz-3/mini/master/Color/Telegram.png
Emby = url-test,占位节点,香港节点,台湾节点,日本节点,韩国节点,新加坡节点,interval = 600,tolerance = 50,img-url = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Emby.png
Game = select,香港,日本,美国,台湾,新加坡,韩国,代理策略,DIRECT,img-url = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Game.png
SpeedTest = select,代理策略,Auto,香港,新加坡,美国,DIRECT,img-url = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Speedtest.png
香港 = url-test,占位节点,香港节点,interval = 600,tolerance = 100,img-url = https://gitlab.com/lodepuly/iconlibrary/-/raw/main/Flag_icon/120px/HK.png
台湾 = url-test,占位节点,台湾节点,interval = 600,tolerance = 100,img-url = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Taiwan.png
新加坡 = url-test,占位节点,新加坡节点,interval = 600,tolerance = 100,img-url = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Singapore.png
日本 = url-test,占位节点,日本节点,interval = 600,tolerance = 100,img-url = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Japan.png
韩国 = url-test,占位节点,韩国节点,interval = 600,tolerance = 100,img-url = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Korea.png
美国 = url-test,占位节点,美国节点,interval = 600,tolerance = 100,img-url = https://gitlab.com/lodepuly/iconlibrary/-/raw/main/Flag_icon/120px/US.png
英国 = url-test,占位节点,英国节点,interval = 600,tolerance = 100,img-url = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/United_Kingdom.png

