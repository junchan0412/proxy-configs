#!name=Applications
#!desc = macOS 常见应用按进程分流；基于当前 Surge.conf 策略组
#!category=#5网络模块
#!system = macOS

[Rule]
# 中国大陆应用与系统服务：保持直连，避免区域、登录和推送异常
PROCESS-NAME,/Applications/WeChat.app/,DIRECT // WeChat #!MACOS-ONLY
PROCESS-NAME,/Applications/抖音.app/,DIRECT // 抖音 #!MACOS-ONLY
PROCESS-NAME,/Applications/QQ.app/,DIRECT // QQ #!MACOS-ONLY
PROCESS-NAME,/Applications/TencentMeeting.app/,DIRECT // 腾讯会议 #!MACOS-ONLY
PROCESS-NAME,/Applications/NetEase Cloud Music.app/,DIRECT // NetEase Cloud Music #!MACOS-ONLY
PROCESS-NAME,/Applications/Bilibili.app/,DIRECT // 哔哩哔哩 #!MACOS-ONLY
PROCESS-NAME,/Applications/iQIYI.app/,DIRECT // 爱奇艺 #!MACOS-ONLY
PROCESS-NAME,/Applications/Youku.app/,DIRECT // 优酷 #!MACOS-ONLY
PROCESS-NAME,/Applications/QuarkCloudDrive.app/,DIRECT // 夸克网盘 #!MACOS-ONLY
PROCESS-NAME,/Applications/Apple Music.app/,DIRECT // Apple Music #!MACOS-ONLY

# AI 应用：沿用主配置中的 AI 策略组
PROCESS-NAME,/Applications/Codex.app/,AI // Codex(App) #!MACOS-ONLY
PROCESS-NAME,/Applications/ChatGPT.app/,AI // ChatGPT #!MACOS-ONLY
PROCESS-NAME,/Applications/Claude.app/,AI // Claude #!MACOS-ONLY
PROCESS-NAME,/Applications/Claude Code.app/,AI // Claude Code #!MACOS-ONLY
PROCESS-NAME,/Applications/Claude Code URL Handler.app/,AI // Claude Code URL Handler #!MACOS-ONLY
PROCESS-NAME,/Applications/Google Gemini.app/,AI // Gemini #!MACOS-ONLY
PROCESS-NAME,/Applications/Google AI Studio.app/,AI // Google AI Studio #!MACOS-ONLY
PROCESS-NAME,/Applications/Perplexity.app/,AI // Perplexity #!MACOS-ONLY
PROCESS-NAME,/Applications/Cursor.app/,AI // Cursor #!MACOS-ONLY
PROCESS-NAME,/Applications/Windsurf.app/,AI // Windsurf #!MACOS-ONLYYY

# 国际通信与社交：沿用国际社媒策略组
PROCESS-NAME,/Applications/AyuGram.app/,国际社媒 // AyuGram #!MACOS-ONLY
PROCESS-NAME,/Applications/Telegram.app/,国际社媒 // Telegram #!MACOS-ONLY
PROCESS-NAME,/Applications/Telegram Beta.app/,国际社媒 // Telegram Beta #!MACOS-ONLY
PROCESS-NAME,/Applications/Discord.app/,国际社媒 // Discord #!MACOS-ONLY
PROCESS-NAME,/Applications/WhatsApp.app/,国际社媒 // WhatsApp #!MACOS-ONLY
PROCESS-NAME,/Applications/Signal.app/,国际社媒 // Signal #!MACOS-ONLY
PROCESS-NAME,/Applications/Slack.app/,国际社媒 // Slack #!MACOS-ONLY
PROCESS-NAME,/Applications/Microsoft Teams.app/,国际社媒 // Microsoft Teams #!MACOS-ONLY
PROCESS-NAME,/Applications/Zoom.app/,国际社媒 // Zoom #!MACOS-ONLY
PROCESS-NAME,/Applications/Skype.app/,国际社媒 // Skype #!MACOS-ONLY
PROCESS-NAME,/Applications/LINE.app/,国际社媒 // LINE #!MACOS-ONLY
PROCESS-NAME,/Applications/Messenger.app/,国际社媒 // Messenger #!MACOS-ONLY
PROCESS-NAME,/Applications/Reddit.app/,国际社媒 // Reddit #!MACOS-ONLY
PROCESS-NAME,/Applications/X.app/,国际社媒 // X #!MACOS-ONLY
PROCESS-NAME,/Applications/Twitter.app/,国际社媒 // Twitter #!MACOS-ONLY

# 海外流媒体：按主配置的地区与机场策略组分流
PROCESS-NAME,/Applications/Spotify.app/,日本 // Spotify #!MACOS-ONLY
PROCESS-NAME,/Applications/YouTube Music.app/,国际社媒 // YouTube Music #!MACOS-ONLY
PROCESS-NAME,/Applications/Netflix.app/,机场合集 // Netflix #!MACOS-ONLY
PROCESS-NAME,/Applications/Disney+.app/,机场合集 // Disney+ #!MACOS-ONLY
PROCESS-NAME,/Applications/HBO Max.app/,机场合集 // HBO Max #!MACOS-ONLY
PROCESS-NAME,/Applications/Twitch.app/,国际社媒 // Twitch #!MACOS-ONLY

# 游戏与游戏平台：沿用 Game 策略组
PROCESS-NAME,/Applications/Steam.app/,Game // Steam #!MACOS-ONLY
PROCESS-NAME,/Applications/Epic Games Launcher.app/,Game // Epic Games #!MACOS-ONLY

# 开发、云服务与国际基础设施
PROCESS-NAME,/Applications/GitHub Desktop.app/,国际基础服务 // GitHub Desktop #!MACOS-ONLY
PROCESS-NAME,/Applications/Docker.app/,国际基础服务 // Docker Desktop #!MACOS-ONLY
PROCESS-NAME,/Applications/OrbStack.app/,国际基础服务 // OrbStack #!MACOS-ONLY
