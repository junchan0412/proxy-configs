[Rewrite]
request if ${url} ~= /^https?:\/\/(www\.)?(g|google)\.cn/i then redirect(302, "https://www.google.com")
request if ${url} ~= /^(http|https):\/\/(ditu|maps)\.google\.cn/i then redirect(302, "https://maps.google.com")

